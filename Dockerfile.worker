# ── Flowra Engine — Celery Worker + Beat Dockerfile ──────────────────────────
# Runs both the Celery worker (executes tasks) and Celery Beat (schedules tasks)
# in one container. For production with high load, split into two separate
# Cloud Run Jobs (one for worker, one for beat).
#
# Build: docker build -f Dockerfile.worker -t flowra-engine-worker .
# Run:   docker run --env-file .env flowra-engine-worker

FROM python:3.11-slim

RUN apt-get update && apt-get install -y \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Start Celery worker + Beat together
# Beat schedule is stored in RAM (no persistent store needed for current tasks).
# If you add many schedules, consider django-celery-beat with DB storage.
CMD ["sh", "-c", \
     "celery -A flowra_engine worker --loglevel=info --concurrency=2 & \
      celery -A flowra_engine beat --loglevel=info && \
      wait"]
