# ─────────────────────────────────────────────────────────────────────────────
# Flowra Engine — Environment Variables
# Copy this file to .env and fill in all values before running.
# NEVER commit the real .env file to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django Core ──────────────────────────────────────────────────────────────

# REQUIRED: Strong random key. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME_TO_STRONG_RANDOM_KEY

# Set to False in production. True only for local development.
DEBUG=False

# Comma-separated allowed hostnames in production.
# Example: flowra-engine-xxxxxxxx-uw.a.run.app,api.flowra.ai
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────

DB_HOST=db.your-project-ref.supabase.co
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_SUPABASE_DB_PASSWORD

# ── Celery + Redis ────────────────────────────────────────────────────────────

# Local dev: redis://localhost:6379/0
# Upstash Redis (production): rediss://:<password>@<host>:<port>/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Auth Secrets ──────────────────────────────────────────────────────────────

# Must match DJANGO_ENGINE_SECRET in Vercel frontend env.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENGINE_SECRET_KEY=CHANGE_ME_ENGINE_SECRET

# Must match DOGRAH_SECRET in Dograh .env and DOGRAH_SECRET in Vercel.
DOGRAH_SECRET=CHANGE_ME_DOGRAH_SECRET

# ── External Services ─────────────────────────────────────────────────────────

# Supabase (for direct table access — same project as frontend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SUPABASE_SERVICE_ROLE_KEY

# Meta WhatsApp Business API (phone number ID + user access token)
META_PHONE_NUMBER_ID=CHANGE_ME
META_ACCESS_TOKEN=CHANGE_ME

# Google Gemini API
GEMINI_API_KEY=CHANGE_ME
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# AES-GCM encryption key for stored credentials (hex, 32 bytes = 64 hex chars)
# Generate: python -c "import os; print(os.urandom(32).hex())"
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# ── Razorpay Billing ──────────────────────────────────────────────────────────

# Get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME_RAZORPAY_SECRET

# Get from https://dashboard.razorpay.com/app/webhooks
# Set endpoint URL: https://<your-engine-url>/executor/billing/webhook/
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# ── Dograh / Voice Agent ──────────────────────────────────────────────────────

# In production: your Cloud Run URL for the Dograh service
# In local dev: ngrok URL (changes every restart)
DOGRAH_API_URL=https://dograh-xxxxxxxx.run.app

# ── Logging ───────────────────────────────────────────────────────────────────

LOG_LEVEL=INFO